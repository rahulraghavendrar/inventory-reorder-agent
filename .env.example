# Copy this file to .env and fill in your key. Never commit .env.
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model name; "gemini-flash-latest" always points to the current Flash model
GEMINI_MODEL=gemini-flash-latest

# true  = agents call the tools through the MCP server (default)
# false = agents call the same Python functions directly
USE_MCP=true

# Optional: inventory file name inside the data/ folder
INVENTORY_CSV=ex7_inventory.csv
